# Example systemd user unit for arenaclub-optimizer's Watch Mode.
#
# 1. Copy it to ~/.config/systemd/user/arena-watch.service.
# 2. Set WorkingDirectory to your clone of the repo, and the filters on
#    ExecStart to what you want watched.
# 3. Run:
#      systemctl --user daemon-reload
#      systemctl --user enable --now arena-watch
#      journalctl --user -u arena-watch -f     # follow its output
#      systemctl --user stop arena-watch       # stop it
#    To keep it running while you are logged out: loginctl enable-linger
#
# On WSL, systemd must be enabled first: add "[boot]" and "systemd=true" to
# /etc/wsl.conf, then run "wsl --shutdown" from Windows and reopen WSL.
#
# The journal keeps the startup lines, which show your Topic; anyone who
# knows the Topic can read your Alerts.

[Unit]
Description=arenaclub-optimizer Watch Mode

[Service]
Type=simple
WorkingDirectory=%h/arenaclub-optimizer
ExecStart=%h/.local/bin/uv run arena watch --quiet --category pokemon --price-max 100
# systemd stops it with SIGTERM: watch then saves its Alert state and exits 0.
TimeoutStopSec=30
# Watch Mode backs off by itself on failed cycles; this only covers a crash
# or a bad config, so it doesn't restart in a tight loop.
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=default.target
